# Apsis Autopilot — LOCAL developer tooling only.
#
# Copy to `.env.autopilot` at the REPOSITORY ROOT (gitignored) or just export
# these in your shell. NAMES ONLY below — never commit a value, and never paste
# a key into a chat.
#
# None of these are read by Apsis. None are VITE_-prefixed, and none may ever
# be: a VITE_ variable is compiled into the browser bundle.

# Required for plan / dry-run / run. Your own key, from platform.openai.com.
OPENAI_API_KEY=

# Planner and reviewer model.
OPENAI_AUTOPILOT_MODEL=gpt-6-astra

# low | medium | high
OPENAI_AUTOPILOT_REASONING_EFFORT=high

# Default implementation worker. A task may select claude-fable-5 for visual work.
APSIS_AUTOPILOT_CLAUDE_MODEL=claude-opus-5

# Path to the Claude Code CLI, if it is not simply `claude` on PATH.
APSIS_AUTOPILOT_CLAUDE_BIN=claude

# Optional hard spend ceiling per worker turn, passed to `claude --max-budget-usd`.
APSIS_AUTOPILOT_WORKER_BUDGET_USD=

# Clamped to 3 by the controller.
APSIS_AUTOPILOT_MAX_REPAIRS=3
