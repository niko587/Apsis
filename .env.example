# Apsis server configuration.
#
# Copy to `.env.local` (gitignored) and fill in. NEVER commit a real value, and
# never prefix any of these with VITE_ — Vite inlines VITE_* into the browser
# bundle, which would publish the secret.
#
# Nothing here is required to run Apsis. With none of it set, the command bar
# runs its deterministic grammar, the interpreter endpoint answers 502, and the
# app works exactly as it does today.

# ---------------------------------------------------------------- model ----
# The language-model interpreter. Server-side only.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5-20251001.
# Escalates to claude-sonnet-5 with no code change.
APSIS_MODEL=

# ----------------------------------------------------------------- auth ----
# WorkOS AuthKit. Server-side only; none of this reaches the browser.
# With these unset, /api/interpret answers 401 — it fails CLOSED, and local
# development falls back to a fixed dev identity that is not in the deployed
# bundle (D38).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# At least 32 characters. The SDK seals the session with this; it is the only
# thing standing between a stolen cookie and its contents.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WORKOS_COOKIE_PASSWORD=
# Absolute URL of the callback, registered in the WorkOS dashboard.
#   local:      http://localhost:5173/api/auth/callback
#   production: https://your-domain/api/auth/callback
WORKOS_REDIRECT_URI=

# ------------------------------------------------------------- hardening ---
# Origin permitted to call /api/interpret. Unset disables the check, which is
# right for curl and local work and wrong for production.
APSIS_ALLOWED_ORIGIN=
