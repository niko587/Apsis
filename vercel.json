{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/interpret.ts": { "supportsCancellation": true },
    "api/session.ts": { "supportsCancellation": true },
    "api/auth/login.ts": { "supportsCancellation": true },
    "api/auth/callback.ts": { "supportsCancellation": true },
    "api/auth/logout.ts": { "supportsCancellation": true }
  },
  "headers": [
    {
      "source": "/apsis-config.js",
      "headers": [{ "key": "cache-control", "value": "no-cache" }]
    }
  ]
}
