{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    /* No DOM. `Request`, `Response`, `Headers`, `fetch` and `AbortSignal` come
       from @types/node (undici), which is the correct source for a Node runtime
       — pulling in lib.dom here would let browser-only globals compile into
       server code and fail at runtime. */
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler resolution, matching tsconfig.app.json: `server/` imports
       COMMAND_SCHEMA from `src/`, and those modules use extensionless relative
       imports. Vercel/esbuild and Vite resolve them the same way. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server", "api"]
}
